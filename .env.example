# Base URL of the opentransit-api instance (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Set to 1 to serve realistic Bogotá fixtures instead of calling the API.
# Useful for UI work, demos and CI screenshots.
NEXT_PUBLIC_MOCK=0

# Set to 0 to hide the /admin section (operators) entirely. Default: enabled.
NEXT_PUBLIC_ADMIN_ENABLED=1

# Single-city deployments (optional)
# NEXT_PUBLIC_DEFAULT_CITY=bogota      # "/" goes straight into this city's app…
# NEXT_PUBLIC_ROOT_LANDING=1           # …or serves its public landing page at "/" (app at /{city})
# NEXT_PUBLIC_SITE_URL=https://example.org   # absolute canonical/OG URLs and sitemap entries

# Deep links (App Links / Universal Links). The app claims this host's URLs, and these
# two files are how the platforms verify that claim. Without them the links open the
# browser instead of the app; with a *wrong* value they fail verification silently.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.jeronimotech.opentransit
ANDROID_PACKAGE_NAME=com.jeronimotech.opentransit
# From Play Console → Setup → App signing, once the app has been uploaded. Comma-separated
# to list both the upload key and the Play App Signing key.
ANDROID_CERT_SHA256=
